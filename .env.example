# Copy to .env.local and fill in values from the Supabase project
# (Settings → API). VITE_* vars are inlined into the browser bundle at
# build time; the rest are read by the server at runtime.

# Browser (public)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-or-publishable-key>"

# Server runtime (SSR, server functions, API routes)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon-or-publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key — secret, never expose to the browser>"

# Shared secret appended (&secret=) to the Monday webhook URLs that
# /api/internal/rotate-boards registers. Must match the same-named secret on
# the Supabase edge function (supabase/functions/monday-live-dispatch), which
# verifies it on delivery.
MONDAY_WEBHOOK_SECRET="<random-long-secret>"

# Bearer token required by /api/internal/rotate-boards. Vercel Cron sends
# Authorization: Bearer <CRON_SECRET> automatically when this is set in the
# project's env. (The Monday API token itself lives in system_settings.)
CRON_SECRET="<random-long-secret>"

# Optional override of the Monday GraphQL endpoint (defaults to
# https://api.monday.com/v2 — only set for testing).
# MONDAY_API_URL=""
